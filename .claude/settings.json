{
  "permissions": {
    "allow": [
      "Skill(langfuse)",
      "Skill(langfuse:*)",
      "Bash(make prompt-guard *)",
      "Bash(git status *)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(.env.local)",
      "Edit(.env.local)",
      "Write(.env.local)",
      "Edit(uv.lock)",
      "Write(uv.lock)",
      "Edit(dist/**)",
      "Write(dist/**)"
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "codex@openai-codex": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "outputStyle": "Simple"
}
