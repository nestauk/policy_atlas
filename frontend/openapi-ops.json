{
  "components": {
    "schemas": {
      "ActionResult": {
        "description": "One subject's result inside a bulk action.\n\nArgs:\n    user_id: The subject.\n    outcome: How it ended.\n    message: The command's one-line summary, or the refusal's reason.\n    action_id: The ``ops_action`` row's id, or ``None`` for ``too_soon``\n        (nothing happened, so nothing was recorded).",
        "properties": {
          "action_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Id"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "outcome": {
            "enum": [
              "ok",
              "failed",
              "too_soon"
            ],
            "title": "Outcome",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "outcome",
          "message"
        ],
        "title": "ActionResult",
        "type": "object"
      },
      "ApproveRequest": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/v1/ops/requests/{entry_id}/approve``.",
        "properties": {
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "org_id"
        ],
        "title": "ApproveRequest",
        "type": "object"
      },
      "BulkEnrol": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/v1/ops/people/enrol``: enrol or move into ``org_id``.",
        "properties": {
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "user_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "User Ids",
            "type": "array"
          }
        },
        "required": [
          "user_ids",
          "org_id"
        ],
        "title": "BulkEnrol",
        "type": "object"
      },
      "BulkOut": {
        "description": "Answer to every bulk action: one result per subject, in request order.",
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/ActionResult"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "BulkOut",
        "type": "object"
      },
      "BulkQuota": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/v1/ops/people/quota``: the same two fields for every subject.",
        "properties": {
          "runs_per_user": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runs Per User"
          },
          "task_quota_per_year": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Quota Per Year"
          },
          "user_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "User Ids",
            "type": "array"
          }
        },
        "required": [
          "task_quota_per_year",
          "runs_per_user",
          "user_ids"
        ],
        "title": "BulkQuota",
        "type": "object"
      },
      "BulkSubjects": {
        "additionalProperties": false,
        "description": "Body of the bulk actions that need only the subjects (de-enrol, offboard, resend).",
        "properties": {
          "user_ids": {
            "items": {
              "type": "string"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "User Ids",
            "type": "array"
          }
        },
        "required": [
          "user_ids"
        ],
        "title": "BulkSubjects",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LimitsOut": {
        "description": "The limits that apply to one person after resolution (contract B12).\n\nArgs:\n    task_quota_per_year: Tasks the person may create in 365 days, or\n        ``None`` for no limit (an administrator, or an override of 0).\n    runs_per_user: Walks the person's tasks may hold at once, or ``None``\n        for no limit (an override of 0).",
        "properties": {
          "runs_per_user": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runs Per User"
          },
          "task_quota_per_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Quota Per Year"
          }
        },
        "required": [
          "task_quota_per_year",
          "runs_per_user"
        ],
        "title": "LimitsOut",
        "type": "object"
      },
      "OrganisationCreate": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/v1/ops/organisations``.",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "OrganisationCreate",
        "type": "object"
      },
      "OrganisationOut": {
        "description": "One organisation as the ops pages list it.\n\nArgs:\n    org_id: The organisation's identity.\n    name: Its display name.\n    created_at: When it was created.\n    people: How many ``app_user`` rows belong to it.\n    task_quota_per_year: Its task-quota override, or ``None`` (inherit).\n    runs_per_user: Its run-cap override, or ``None`` (inherit).\n    domains: Email domains that join it by self-signup (contract C1).\n        Read-only on the ops pages; the CLI edits the table.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "domains": {
            "items": {
              "type": "string"
            },
            "title": "Domains",
            "type": "array"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "people": {
            "title": "People",
            "type": "integer"
          },
          "runs_per_user": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runs Per User"
          },
          "task_quota_per_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Quota Per Year"
          }
        },
        "required": [
          "org_id",
          "name",
          "created_at",
          "people",
          "domains"
        ],
        "title": "OrganisationOut",
        "type": "object"
      },
      "OrganisationRef": {
        "description": "The organisation the caller belongs to.\n\nArgs:\n    org_id: The organisation's identity.\n    name: Its display name.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "name"
        ],
        "title": "OrganisationRef",
        "type": "object"
      },
      "PersonCreate": {
        "additionalProperties": false,
        "description": "Body of ``POST /api/v1/ops/people``: create a person in an organisation.\n\nThe organisation is required (contract B4): a browser-created account is\nnever unenrolled. The route calls the ensure-account command, so an\naddress that already has an unenrolled account is enrolled without a\nsecond invitation.",
        "properties": {
          "display_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "org_id"
        ],
        "title": "PersonCreate",
        "type": "object"
      },
      "PersonCreatedOut": {
        "description": "Answer to ``POST /api/v1/ops/people``.\n\nArgs:\n    person: The person as the list now shows them.\n    invitation_sent: Whether Cognito sent an invitation on this call.\n        ``False`` when the address already had an account.",
        "properties": {
          "invitation_sent": {
            "title": "Invitation Sent",
            "type": "boolean"
          },
          "person": {
            "$ref": "#/components/schemas/PersonOut"
          }
        },
        "required": [
          "person",
          "invitation_sent"
        ],
        "title": "PersonCreatedOut",
        "type": "object"
      },
      "PersonOut": {
        "description": "One person as the ops pages list them (contract B4 \"list people\").\n\nArgs:\n    user_id: The Cognito subject.\n    display_name: The stored name (never derived from the email here).\n    email: The stored address, or ``None`` for a person who only ever\n        signed in. Ops-facing: this shape never leaves the ops host.\n    organisation: Their organisation, or ``None`` when unenrolled.\n    is_admin: Whether they hold the administrator flag.\n    is_ops: Whether they hold the ops role.\n    created_at: When the row was created.\n    invited_at: When Cognito last sent them an invitation through this\n        service, or ``None``. The resend cooldown reads it.\n    task_quota_per_year: Their own override, or ``None``.\n    runs_per_user: Their own override, or ``None``.\n    tasks_this_year: Tasks they created in the last 365 days.\n    limits: The limits that apply after resolution.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "invited_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invited At"
          },
          "is_admin": {
            "title": "Is Admin",
            "type": "boolean"
          },
          "is_ops": {
            "title": "Is Ops",
            "type": "boolean"
          },
          "limits": {
            "$ref": "#/components/schemas/LimitsOut"
          },
          "organisation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrganisationRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "runs_per_user": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runs Per User"
          },
          "task_quota_per_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Quota Per Year"
          },
          "tasks_this_year": {
            "title": "Tasks This Year",
            "type": "integer"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "display_name",
          "is_admin",
          "is_ops",
          "created_at",
          "tasks_this_year",
          "limits"
        ],
        "title": "PersonOut",
        "type": "object"
      },
      "QuotaSet": {
        "additionalProperties": false,
        "description": "The two override fields of a quota form (contract B12).\n\n``None`` clears the override so the next level applies; ``0`` means no\nlimit. Both fields are always sent: the form shows both.",
        "properties": {
          "runs_per_user": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runs Per User"
          },
          "task_quota_per_year": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Quota Per Year"
          }
        },
        "required": [
          "task_quota_per_year",
          "runs_per_user"
        ],
        "title": "QuotaSet",
        "type": "object"
      },
      "RequestOut": {
        "description": "One waitlist row as the Requests page shows it.\n\nArgs:\n    entry_id: The row.\n    email: The requested address.\n    name: The name they gave.\n    organisation: The organisation they typed, if any.\n    role_or_reason: Why they asked.\n    created_at: When they asked.\n    status: See :data:`RequestStatus`.\n    account_user_id: The subject once an account exists.\n    account_created_at: When the row was stamped.\n    note: For ``check``, which organisation the address already belongs\n        to; otherwise ``None``.",
        "properties": {
          "account_created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Created At"
          },
          "account_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account User Id"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "entry_id": {
            "format": "uuid",
            "title": "Entry Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "organisation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Organisation"
          },
          "role_or_reason": {
            "title": "Role Or Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "waiting",
              "invited",
              "check"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "entry_id",
          "email",
          "name",
          "role_or_reason",
          "created_at",
          "status"
        ],
        "title": "RequestOut",
        "type": "object"
      },
      "RequestsOut": {
        "description": "Answer to ``GET /api/v1/ops/requests``.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RequestOut"
            },
            "title": "Items",
            "type": "array"
          },
          "self_signup": {
            "$ref": "#/components/schemas/SelfSignupOut"
          }
        },
        "required": [
          "items",
          "self_signup"
        ],
        "title": "RequestsOut",
        "type": "object"
      },
      "SelfSignupOut": {
        "description": "The self-signup sweep's state, shown above the Requests list (contract C3, C4).\n\nArgs:\n    enabled: Whether the sweep runs on this service.\n    domains: The listed domains.\n    sent_this_hour: Invitations the sweep sent in the last hour.\n    max_per_hour: The hourly cap.",
        "properties": {
          "domains": {
            "items": {
              "type": "string"
            },
            "title": "Domains",
            "type": "array"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "max_per_hour": {
            "title": "Max Per Hour",
            "type": "integer"
          },
          "sent_this_hour": {
            "title": "Sent This Hour",
            "type": "integer"
          }
        },
        "required": [
          "enabled",
          "domains",
          "sent_this_hour",
          "max_per_hour"
        ],
        "title": "SelfSignupOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Policy Atlas Ops API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/ops/organisations": {
      "get": {
        "description": "List organisations alphabetically with their people and domains.",
        "operationId": "list_organisations_api_v1_ops_organisations_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OrganisationOut"
                  },
                  "title": "Response List Organisations Api V1 Ops Organisations Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Organisations",
        "tags": [
          "ops"
        ]
      },
      "post": {
        "description": "Create an organisation and its durable audit record.",
        "operationId": "create_organisation_api_v1_ops_organisations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Organisation",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/ops/organisations/{org_id}/quota": {
      "post": {
        "description": "Set or clear an organisation's quota overrides.",
        "operationId": "set_organisation_quota_api_v1_ops_organisations__org_id__quota_post",
        "parameters": [
          {
            "in": "path",
            "name": "org_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Org Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuotaSet"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Set Organisation Quota",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/ops/people": {
      "get": {
        "description": "List people, optionally matching a literal case-insensitive search string.",
        "operationId": "list_people_api_v1_ops_people_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PersonOut"
                  },
                  "title": "Response List People Api V1 Ops People Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List People",
        "tags": [
          "ops"
        ]
      },
      "post": {
        "description": "Ensure a person is invited and enrolled in the requested organisation.",
        "operationId": "create_person_api_v1_ops_people_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonCreatedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Person",
        "tags": [
          "ops"
        ]
      }
    },
    "/api/v1/ops/people/de-enrol": {
      "post": {
        "description": "De-enrol every selected person independently.",
        "operationId": "de_enrol_people_api_v1_ops_people_de_enrol_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkSubjects"
              }
