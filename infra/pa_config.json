{
    "staging": {
        "aws_region": "eu-west-2",
        "policy_atlas_config": {
            "domain_name": "v3.policyatlas.uk",
            "backend_subdomain": "api",
            "cognito_domain_prefix": "policy-atlas-v3",
            "csp_mode": "enforce",
            "email": {
                "enabled": true,
                "sender_domain": "v3.policyatlas.uk",
                "from_address": "no-reply@v3.policyatlas.uk",
                "from_name": "Policy Atlas",
                "announcements": false,
                "pictures": false,
                "reply_to": "discoveryhub@nesta.org.uk"
            },
            "backend": {
                "cpu": 2048,
                "memory_limit_mib": 8192,
                "internal_port": 8000,
                "secret_name": "policy_atlas_v3/app",
                "model_route": "bedrock",
                "ingest_mode": "queued",
                "run_executor_max": 10,
                "runs_per_user": 3,
                "task_quota_per_year": 50,
                "db_pool_size": 15,
                "db_max_overflow": 10,
                "upload_bucket_name": "policy-atlas-v3-staging-uploads",
                "theory_of_change": true,
                "waf": {"enabled": true, "mode": "block", "captcha": true}
            },
            "ops": {
                "subdomain": "ops",
                "cpu": 256,
                "memory_limit_mib": 512,
                "desired_count": 1,
                "allowed_cidrs_parameter_name": "/policy_atlas_v3/ops/allowed_cidrs"
            },
            "self_signup": {
                "enabled": false,
                "max_per_hour": 100
            },
            "sign_in": {"mfa": "app", "page": "managed", "domain": "auth.v3.policyatlas.uk"}
        },
        "deploy_analytics": true
    },
    "prod": {
        "aws_region": "eu-west-2",
        "policy_atlas_config": {
            "domain_name": "policyatlas.uk",
            "backend_subdomain": "api",
            "cognito_domain_prefix": "policy-atlas-v3-prod",
            "csp_mode": "enforce",
            "email": {
                "enabled": true,
                "sender_domain": "policyatlas.uk",
                "from_address": "no-reply@policyatlas.uk",
                "from_name": "Policy Atlas",
                "announcements": false,
                "pictures": false,
                "reply_to": "discoveryhub@nesta.org.uk"
            },
            "backend": {
                "cpu": 2048,
                "memory_limit_mib": 8192,
                "internal_port": 8000,
                "secret_name": "policy_atlas_v3/app",
                "model_route": "bedrock",
                "ingest_mode": "queued",
                "run_executor_max": 10,
                "runs_per_user": 3,
                "task_quota_per_year": 50,
                "db_pool_size": 15,
                "db_max_overflow": 10,
                "upload_bucket_name": "policy-atlas-v3-prod-uploads",
                "theory_of_change": false,
                "waf": {"enabled": true, "mode": "block", "captcha": true}
            },
            "ops": {
                "subdomain": "ops",
                "cpu": 256,
                "memory_limit_mib": 512,
                "desired_count": 1,
                "allowed_cidrs_parameter_name": "/policy_atlas_v3/ops/allowed_cidrs"
            },
            "self_signup": {
                "enabled": false,
                "max_per_hour": 5
            },
            "sign_in": {"mfa": "app", "page": "managed", "domain": "auth.policyatlas.uk"}
        },
        "deploy_analytics": true
    }
}
