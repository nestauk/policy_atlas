DATABASE_URL=postgresql+psycopg://policy_atlas:policy_atlas@localhost:5432/policy_atlas
# Tests run against a separate database; `make test`/`make verify` set this automatically.
# Override only to point tests elsewhere:
# TEST_DATABASE_URL=postgresql+psycopg://policy_atlas:policy_atlas@localhost:5432/policy_atlas_test

# --- Web API (task 025) — required by `make -C backend dev` ---
# `uv run` auto-loads this file (backend/.env, gitignored) — copy this file to
# `.env` in `backend/` and the defaults below just work for local dev against
# the dev-issuer (never a real IdP; AWS Cognito lands with the `infra/` slice).
#
# Sole browser origin CORS will accept — the frontend's Vite dev server:
APP_ORIGIN=http://localhost:5173
# Dev-issuer identity (see the bootstrap below) — must match what you mint
# tokens with. Cognito deployments set these to the real user-pool issuer/app
# client id instead.
OIDC_ISSUER=http://dev-issuer.local
OIDC_CLIENT_ID=policy-atlas-dev
# Exactly one of OIDC_JWKS_URL / OIDC_JWKS_PATH must be set. The dev issuer
# writes its JWKS here; a real deployment sets OIDC_JWKS_URL to the issuer's
# remote JWKS endpoint instead (and leaves this one unset).
OIDC_JWKS_PATH=.dev-issuer/jwks.json
# OIDC_JWKS_URL=
#
# Dev-issuer bootstrap (run once, from `backend/`):
#   uv run python -m policy_atlas.api.dev_issuer init --dir .dev-issuer
# Mint a token to use with the frontend's "paste a dev token" panel:
#   uv run python -m policy_atlas.api.dev_issuer mint --dir .dev-issuer \
#     --sub dev-user --client-id policy-atlas-dev

# --- Search-backend API keys ---
# Read in two places: (1) the fixture recorder scripts (scripts/record_*_fixtures.py,
# run manually by a developer); (2) the live runner backends behind the API and the
# orchestrate CLI — when the backend mode is live (see PA_BACKEND_MODE below), runs
# search with whichever of these are set and warn at boot about the missing ones
# (coverage degrades honestly). Tests and CI never touch the network (committed
# sanitized fixtures + socket-deny; conftest scrubs these keys from the test process).
# Production keys will live in the deployment secret store, not here.
# Required by scripts/record_overton_fixtures.py (Overton issues one key per user account):
OVERTON_API_KEY=
# Optional for scripts/record_openalex_fixtures.py (keyless works; a key avoids the
# anonymous-search rate limit):
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# --- Live inference route (task 009+: embeddings + thematic grouping) ---
# The FIRST product-egress keys (ADR 0005). Key presence is live intent for the
# orchestrate CLI AND the web API's planner/router/runner backends; the test suite
# and library defaults NEVER read these (stub backends + socket-deny enforce that).
# Env-only: never a parameter default, never logged, never committed.
#
# Make the posture explicit instead of key-driven (task 025 review):
#   PA_BACKEND_MODE=auto   (default) live iff OPENAI_API_KEY is set
#   PA_BACKEND_MODE=live   demand live; boot FAILS without OPENAI_API_KEY
#   PA_BACKEND_MODE=stub   pin stubs even on a keyed box (demos, load tests)
# PA_BACKEND_MODE=auto
# Embeddings: text-embedding-3-small · grouping: gpt-5-mini (discover + assign;
# the plan's gpt-5-nano assignment pin was flipped on live evidence — see
# grouping.py), both behind seams (EmbeddingBackend / GroupingBackend → Bedrock later).
OPENAI_API_KEY=

# --- Synthesis writer (task 034 D9) ---
# Application default is gpt-5.6-terra. Uncomment to pin gpt-5.5 (or any
# listed model) without a code change. Restart the API after changing —
# the value is read at import.
# POLICY_ATLAS_SYNTHESIS_MODEL=gpt-5.5

# --- Langfuse trace backbone (task 009+; decision 13 / ADR 0005) ---

# Full-I/O, eval-ready tracing of the two live backends. All-unset => tracing is a
# no-op (stubs are never traced; make verify needs none of these). With keys set,
# the host is REQUIRED — it pins traces to the user-operated instance; without it
# the SDK would default to Langfuse's SaaS cloud, so get_langfuse() fails loudly
# instead. LANGFUSE_BASE_URL (the SDK v4 name) is honored as an alias.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
