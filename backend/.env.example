DATABASE_URL=postgresql+psycopg://policy_atlas:policy_atlas@localhost:5432/policy_atlas
# Tests run against a separate database; `make test`/`make verify` set this automatically.
# Override only to point tests elsewhere:
# TEST_DATABASE_URL=postgresql+psycopg://policy_atlas:policy_atlas@localhost:5432/policy_atlas_test

# --- Search-backend API keys (dev-time only in v3.0) ---
# Used ONLY by the fixture recorder scripts (scripts/record_*_fixtures.py at the repo
# root, run as `uv run --project backend python scripts/record_*.py`), run manually by
# a developer. Package code never reads these; tests and CI never touch the network
# (they run on committed sanitized fixtures). Runtime egress is a gated seam — when live
# backends land, production keys will live in the deployment secret store, not here.
# Required by scripts/record_overton_fixtures.py (Overton issues one key per user account):
OVERTON_API_KEY=
# Optional for scripts/record_openalex_fixtures.py (keyless works; a key avoids the
# anonymous-search rate limit):
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# --- Live inference route (task 009+: embeddings + thematic grouping) ---
# The FIRST product-egress keys (ADR 0005). Key presence is live intent on the
# skeleton/demo entrypoint; the test suite and library defaults NEVER read these
# (stub backends + socket-deny enforce that). Env-only: never a parameter default,
# never logged, never committed.
# Embeddings: text-embedding-3-small · grouping: gpt-5-mini (discover + assign;
# the plan's gpt-5-nano assignment pin was flipped on live evidence — see
# grouping.py), both behind seams (EmbeddingBackend / GroupingBackend → Bedrock later).
OPENAI_API_KEY=

# --- Langfuse trace backbone (task 009+; decision 13 / ADR 0005) ---
# Full-I/O, eval-ready tracing of the two live backends. All-unset => tracing is a
# no-op (stubs are never traced; make verify needs none of these). With keys set,
# the host is REQUIRED — it pins traces to the user-operated instance; without it
# the SDK would default to Langfuse's SaaS cloud, so get_langfuse() fails loudly
# instead. LANGFUSE_BASE_URL (the SDK v4 name) is honored as an alias.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
